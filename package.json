{
  "name": "slides",
  "version": "0.1.7",
  "private": true,
  "description": "Create, check, export, present, and edit hand-built HTML slide decks with coding agents",
  "type": "module",
  "bin": {
    "slides": "bin/slides.js"
  },
  "scripts": {
    "dev": "node bin/slides.js serve site/demo-slides/index.html --open",
    "start": "node bin/slides.js serve site/demo-slides/index.html",
    "test": "npm run test:unit && npm run test:browser && npm run validate",
    "test:unit": "node --test test/*.unit.test.js",
    "test:browser": "node --test test/*.browser.test.js",
    "validate": "node scripts/validate.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dwmkerr/slides.git"
  },
  "bugs": {
    "url": "https://github.com/dwmkerr/slides/issues"
  },
  "homepage": "https://dwmkerr.github.io/slides/",
  "keywords": [
    "agent-skills",
    "presentations",
    "slides",
    "html",
    "coding-agents"
  ],
  "author": "Dave Kerr",
  "license": "MIT",
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "playwright": "^1.62.1"
  }
}
